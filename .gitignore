# Build output. Published to gh-pages, never committed to the default branch.
/dist/

# Build intermediates and downloaded tools: the pmtiles and uv binaries, the
# vendored asset checkout. All re-fetched by build.sh on a clean checkout.
/.work/

# uv's project environment. uv.lock is committed; this is not.
/.venv/

node_modules/

# Never commit any of these, on either branch. They are hundreds of megabytes
# and are byproducts, not sources.
*.osm.pbf
*.mbtiles
*.pmtiles
planet*.pmtiles

.DS_Store
